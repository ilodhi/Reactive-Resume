# =============================================================================
# Resume Builder (Adam Lodhi) — privacy-first defaults
# Based on Reactive Resume v6. Leave AI / OAuth / job-search / S3 blank.
#
# Vercel: do NOT paste this whole file. Connect Neon + private Blob + Upstash
# in the Deploy wizard, then set only AUTH_SECRET + ENCRYPTION_SECRET
# (+ optional FLAG_DISABLE_SIGNUPS / CRON_SECRET / SMTP).
# =============================================================================

# --- Application ---
PORT="3000"
SERVER_PORT="3001"
TRUSTED_PROXIES=""

# Public URL. On Vercel this is auto-derived; set it for a custom domain.
APP_URL="http://localhost:3000"

# Optional: serve one already-public resume at /. Use the ID from /builder/<id>.
# ROOT_RESUME_ID=

# --- Database (PostgreSQL) ---
# Local / Docker: use the compose Postgres service.
# Vercel: injected as DATABASE_URL / POSTGRES_URL from Neon — do not hardcode.
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/postgres"

# Neon direct URL for migrations (optional; Vercel falls back to unpooled aliases).
# DATABASE_MIGRATION_URL=""
# DATABASE_POOL_MAX="10"

STRICT_SCHEMA_CHECK="false"

# --- Authentication ---
# REQUIRED. Generate: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-secure-secret-key-in-production"

# Better Auth Dashboard (optional — leave blank)
BETTER_AUTH_API_KEY=""

# OpenAI plugin challenge (optional — leave blank for privacy)
OPENAI_APPS_CHALLENGE_TOKEN=""

# --- Social Auth (OPTIONAL — leave blank for email/password + passkeys only) ---
# Filling these sends users through Google/GitHub/LinkedIn during sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

OAUTH_PROVIDER_NAME=""
OAUTH_CLIENT_ID=""
OAUTH_CLIENT_SECRET=""
OAUTH_DISCOVERY_URL=""
OAUTH_AUTHORIZATION_URL=""
OAUTH_TOKEN_URL=""
OAUTH_USER_INFO_URL=""
OAUTH_SCOPES="openid profile email"

# --- Email (optional) ---
# Without SMTP, verification / reset emails are written to server / Function logs.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Resume Builder <noreply@localhost>"
SMTP_SECURE="false"

# --- Storage ---
# Local / Docker: use filesystem (no cloud).
STORAGE_BACKEND="local"
# LOCAL_STORAGE_PATH="/app/data"

# Vercel: omit STORAGE_BACKEND (or set blob). Marketplace injects BLOB_READ_WRITE_TOKEN.
# Never set S3_* on Vercel — the build refuses non-Blob storage.
# BLOB_READ_WRITE_TOKEN=""
# BLOB_STORE_ID=""
# DEPLOYMENT_NAMESPACE="production"
# ALLOW_PREVIEW_MIGRATIONS=true   # Preview only, with isolated Neon/Blob/Redis

# Docker Compose SeaweedFS example (local only — do not paste into Vercel):
# S3_ACCESS_KEY_ID="seaweedfs"
# S3_SECRET_ACCESS_KEY="seaweedfs"
# S3_REGION="us-east-1"
# S3_ENDPOINT="http://seaweedfs:8333"
# S3_BUCKET="reactive-resume"
# S3_FORCE_PATH_STYLE="true"

# --- Redis / encryption ---
# Local Docker: redis service below.
# Vercel: Upstash injects REDIS_URL or KV_URL (required for Vercel builds).
REDIS_URL="redis://redis:6379"

# REQUIRED on Vercel (and for any saved AI keys). Generate a DIFFERENT secret:
#   openssl rand -hex 32
# Does not by itself call OpenAI — it only encrypts keys if someone saves them.
ENCRYPTION_SECRET="change-me-to-a-secure-agent-secret-in-production"

# --- Web access / job search (OPTIONAL — leave blank for privacy) ---
# WEB_ACCESS_PROVIDER="tavily"
# WEB_ACCESS_API_KEY=""
# WEB_ACCESS_PROVIDER="firecrawl"
# WEB_ACCESS_API_URL="http://localhost:3102"

# --- Shared AI provider (OPTIONAL — leave blank for privacy) ---
# When unset, core resume features work; no LLM traffic leaves your deployment.
# AI_PROVIDER="openai"
# AI_MODEL="gpt-5-mini"
# AI_API_KEY=""
# AI_BASE_URL=""

# Authenticates GET/POST /api/career/run (Vercel Cron). Optional for personal use.
# CRON_SECRET="replace-with-a-random-secret-at-least-16-characters"

# --- Feature flags ---
FLAG_DISABLE_SIGNUPS="false"
FLAG_DISABLE_EMAIL_AUTH="false"
FLAG_DISABLE_IMAGE_PROCESSING="false"
FLAG_DISABLE_API_RATE_LIMIT="false"
FLAG_ALLOW_UNSAFE_OAUTH_REDIRECT_URI="false"
FLAG_ALLOW_UNSAFE_AI_BASE_URL="false"

# --- Tooling only (optional — leave blank) ---
GOOGLE_CLOUD_API_KEY=""
CROWDIN_PROJECT_ID=""
CROWDIN_API_TOKEN=""
